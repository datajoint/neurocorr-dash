# Copy to .env and fill in. Never commit .env.
DJ_HOST=localhost
DJ_PORT=5432
DJ_BACKEND=postgresql
DJ_USER=datajoint
DJ_PASS=
# Schema prefix of the pipeline, if it was declared with one
DATABASE_PREFIX=
# The pipeline's object store, where its arrays are, e.g. a local file store:
# DJ_STORES={"default": "main", "main": {"protocol": "file", "location": "/path/to/neurocorr/data/store"}}
